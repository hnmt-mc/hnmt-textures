{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:keybind_down",
    "keybind": "key.use",
    "on_true": {
      "type": "minecraft:model",
      "model": "hnmt:item/gun/matchlock_aim"
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "hnmt:item/gun/matchlock_loaded_icon"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "hnmt:item/gun/matchlock_loaded"
      }
    }
  }
}
